  box-shadow: var(--shadow-sm);
  padding: 1.5rem;
  border: 1px solid var(--border);
  cursor: pointer;
  transition: var(--transition);
}
.product-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
}
.product-card__img {
  width: 100%;
  height: 160px;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 1rem;
  background: var(--surface2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text3);
  font-size: 2.5rem;
}
.product-card__name {
  font-weight: 600;
  margin-bottom: 4px;
}
.product-card__sku {
  font-size: 12px;
  color: var(--text3);
  margin-bottom: 0.75rem;
}
.product-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 0.875rem;
  padding-top: 0.875rem;
  border-top: 1px solid var(--border);
}
.product-card__price {
  font-weight: 700;
  font-size: 1.0625rem;
  color: var(--accent);
}
.product-card__stock {
  font-size: 12px;
  color: var(--text3);
}
.product-card__actions {
  display: flex;
  gap: 6px;
}

.cart-sidebar {
  position: fixed;
  top: 0;
  right: 0;
  height: 100vh;
  width: 360px;
  background: var(--surface);
  box-shadow: -4px 0 24px rgba(0, 0, 0, 0.12);
  z-index: 400;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.3s ease;
}
.cart-sidebar.open {
  transform: translateX(0);
}
.cart-sidebar__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--border);
}
.cart-sidebar__header h3 {
  font-weight: 700;
}
.cart-sidebar__body {
  flex: 1;
  overflow-y: auto;
  padding: 1rem 1.5rem;
}
.cart-sidebar__footer {
  padding: 1.25rem 1.5rem;
  border-top: 1px solid var(--border);
}
.cart-sidebar__footer .total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 700;
  font-size: 1rem;
  margin-bottom: 1rem;
}
.cart-sidebar .cart-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.875rem 0;
  border-bottom: 1px solid var(--border);
  gap: 0.75rem;
}
.cart-sidebar .cart-item__info {
  flex: 1;
}
.cart-sidebar .cart-item__name {
  font-weight: 600;
  font-size: 0.875rem;
}
.cart-sidebar .cart-item__price {
  font-size: 12px;
  color: var(--text3);
}
.cart-sidebar .cart-item__qty {
  display: flex;
  align-items: center;
  gap: 6px;
}
.cart-sidebar .cart-item__qty button {
  width: 26px;
  height: 26px;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
.cart-sidebar .cart-item__qty button:hover {
  background: var(--surface2);
}
.cart-sidebar .cart-item__qty span {
  font-weight: 600;
  min-width: 24px;
  text-align: center;
}
.cart-sidebar .cart-item__remove {
  color: var(--text3);
  cursor: pointer;
}
.cart-sidebar .cart-item__remove:hover {
  color: var(--red);
}

.alert-card {
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: 1.5rem;
  border: 1px solid var(--border);
  border-left: 4px solid var(--amber);
}
.alert-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}
.alert-card__header h4 {
  font-weight: 700;
  font-size: 0.9375rem;
}
.alert-card .alert-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.65rem 0;
  border-bottom: 1px solid var(--border);
  font-size: 0.875rem;
}
.alert-card .alert-item:last-child {
  border-bottom: none;
}
.alert-card .alert-item .name {
  font-weight: 500;
}
.alert-card .alert-item .stock {
  color: var(--red);
  font-weight: 600;
}

:root {
  --accent: #FF6B35;
  --accent-light: #FFF1EB;
  --blue: #3B82F6;
  --blue-light: #EFF6FF;
  --green: #22C55E;
  --green-light: #F0FDF4;
  --amber: #F59E0B;
  --amber-light: #FFFBEB;
  --red: #EF4444;
  --red-light: #FEF2F2;
  --purple: #8B5CF6;
  --purple-light: #F5F3FF;
  --bg: #F8FAFC;
  --surface: #FFFFFF;
  --surface2: #F1F5F9;
  --border: #E2E8F0;
  --text: #0F172A;
  --text2: #475569;
  --text3: #94A3B8;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
  --shadow-md: 0 4px 16px rgba(0,0,0,.12);
  --radius: 12px;
  --sidebar-w: 260px;
  --topbar-h: 64px;
  --transition: all 0.2s ease;
}

.kanban-board {
  display: flex;
  gap: 1.25rem;
  align-items: flex-start;
  overflow-x: auto;
  padding-bottom: 1rem;
  min-height: calc(100vh - 280px);
}

.kanban-column {
  flex: 1;
  min-width: 300px;
  max-width: 380px;
  background: var(--surface2);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  max-height: calc(100vh - 280px);
}
.kanban-column__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.125rem;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  background: var(--surface2);
  border-radius: var(--radius) var(--radius) 0 0;
}
.kanban-column__header .col-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  font-size: 0.875rem;
}
.kanban-column__header .col-count {
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 1px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  color: var(--text2);
}
.kanban-column__header .col-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}
.kanban-column__header .col-dot--pending {
  background: var(--amber);
}
.kanban-column__header .col-dot--in_progress {
  background: var(--blue);
}
.kanban-column__header .col-dot--delivered {
  background: var(--green);
}
.kanban-column__cards {
  flex: 1;
  overflow-y: auto;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.kanban-card {
  background: var(--surface);
  border-radius: 10px;
  border: 1px solid var(--border);
  padding: 1rem;
  box-shadow: var(--shadow-sm);
  transition: var(--transition);
}
.kanban-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}
.kanban-card__id {
  font-size: 11px;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 6px;
}
.kanban-card__customer {
  font-weight: 600;
  font-size: 0.875rem;
  margin-bottom: 4px;
}
.kanban-card__address {
  font-size: 12px;
  color: var(--text3);
  margin-bottom: 8px;
  display: flex;
  align-items: flex-start;
  gap: 4px;
}
.kanban-card__address svg {
  flex-shrink: 0;
  margin-top: 2px;
}
.kanban-card__meta {
  display: flex;
  gap: 8px;
  margin-bottom: 10px;
  font-size: 12px;
  color: var(--text2);
}
.kanban-card__cod {
  background: var(--amber-light);
  color: #b45309;
  padding: 3px 8px;
  border-radius: 6px;
  font-weight: 700;
  font-size: 12px;
  margin-bottom: 10px;
}
.kanban-card__rider {
  margin-bottom: 10px;
}
.kanban-card__rider select {
  width: 100%;
  padding: 0.4rem 0.625rem;
  border-radius: 7px;
  border: 1px solid var(--border);
  font-size: 0.8125rem;
  color: var(--text);
  background: var(--surface);
  cursor: pointer;
}
.kanban-card__actions {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

:root {
  --accent: #FF6B35;
  --accent-light: #FFF1EB;
  --blue: #3B82F6;
  --blue-light: #EFF6FF;
  --green: #22C55E;
  --green-light: #F0FDF4;
  --amber: #F59E0B;
  --amber-light: #FFFBEB;
  --red: #EF4444;
  --red-light: #FEF2F2;
  --purple: #8B5CF6;
  --purple-light: #F5F3FF;
  --bg: #F8FAFC;
  --surface: #FFFFFF;
  --surface2: #F1F5F9;
  --border: #E2E8F0;
  --text: #0F172A;
  --text2: #475569;
  --text3: #94A3B8;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
  --shadow-md: 0 4px 16px rgba(0,0,0,.12);
  --radius: 12px;
  --sidebar-w: 260px;
  --topbar-h: 64px;
  --transition: all 0.2s ease;
}

.landing {
  font-family: "DM Sans", sans-serif;
  overflow-x: hidden;
}

.landing-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 5%;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
}
.landing-nav__logo {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--text);
  letter-spacing: -0.03em;
}
.landing-nav__logo span {
  color: var(--accent);
}
.landing-nav__links {
  display: flex;
  gap: 2rem;
  align-items: center;
}
.landing-nav__links a {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text2);
  transition: var(--transition);
}
.landing-nav__links a:hover {
  color: var(--text);
}
.landing-nav__ctas {
  display: flex;
  gap: 0.75rem;
  align-items: center;
}
.landing-nav__ctas .btn-ghost {
  background: transparent;
  color: var(--text);
  border: none;
  border-radius: 8px;
  padding: 0.5rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.landing-nav__ctas .btn-ghost:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}
.landing-nav__ctas .btn-ghost:active {
  transform: translateY(0);
}
.landing-nav__ctas .btn-ghost {
  border: 1px solid var(--border);
}
.landing-nav__ctas .btn-ghost:hover {
  background: var(--surface2);
  transform: none;
}
.landing-nav__ctas .btn-primary {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 0.5rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.landing-nav__ctas .btn-primary:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}
.landing-nav__ctas .btn-primary:active {
  transform: translateY(0);
}

.landing-hero {
  padding: 6rem 5% 5rem;
  text-align: center;
  background: linear-gradient(135deg, #fff 0%, #FFF1EB 50%, #EFF6FF 100%);
  position: relative;
  overflow: hidden;
}
.landing-hero::before {
  content: "";
  position: absolute;
  width: 600px;
  height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 107, 53, 0.08) 0%, transparent 70%);
  top: -200px;
  right: -200px;
}
.landing-hero h1 {
  font-size: clamp(2.25rem, 5vw, 3.5rem);
  font-weight: 800;
  color: var(--text);
  letter-spacing: -0.04em;
  line-height: 1.15;
  margin-bottom: 1.25rem;
  max-width: 700px;
  margin-inline: auto;
}
.landing-hero h1 span {
  color: var(--accent);
}
.landing-hero p {
  font-size: 1.125rem;
  color: var(--text2);
  max-width: 540px;
  margin: 0 auto 2.5rem;
  line-height: 1.65;
}
.landing-hero__ctas {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}
.landing-hero__ctas .btn-primary {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 0.5rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.landing-hero__ctas .btn-primary:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}
.landing-hero__ctas .btn-primary:active {
  transform: translateY(0);
}
.landing-hero__ctas .btn-primary {
  font-size: 1rem;
  padding: 0.875rem 2rem;
}
.landing-hero__ctas .btn-secondary {
  background: transparent;
  color: var(--text);
  border: none;
  border-radius: 8px;
  padding: 0.5rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.landing-hero__ctas .btn-secondary:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}
.landing-hero__ctas .btn-secondary:active {
  transform: translateY(0);
}
.landing-hero__ctas .btn-secondary {
  border: 2px solid var(--border);
  font-size: 1rem;
  padding: 0.875rem 2rem;
  filter: none;
}
.landing-hero__ctas .btn-secondary:hover {
  background: var(--surface);
  transform: none;
}
.landing-hero__stats {
  display: flex;
  gap: 2rem;
  justify-content: center;
  margin-top: 3.5rem;
  flex-wrap: wrap;
}
.landing-hero__stats .stat {
  text-align: center;
}
.landing-hero__stats .stat .val {
  font-size: 2rem;
  font-weight: 800;
  color: var(--text);
}
.landing-hero__stats .stat .lbl {
  font-size: 0.8125rem;
  color: var(--text3);
}

.landing-features {
  padding: 5rem 5%;
  text-align: center;
}
.landing-features .section-header {
  margin-bottom: 3rem;
}
.landing-features .section-header h2 {
  font-size: 2rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  margin-bottom: 0.75rem;
}
.landing-features .section-header p {
  color: var(--text2);
  font-size: 1rem;
}
.landing-features .features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
@media (max-width: 900px) {
  .landing-features .features-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 600px) {
  .landing-features .features-grid {
    grid-template-columns: 1fr;
  }
}
.landing-features .feature-card {
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: 1.5rem;
  border: 1px solid var(--border);
  text-align: left;
  transition: var(--transition);
}
.landing-features .feature-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}
.landing-features .feature-card .feature-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: var(--accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  margin-bottom: 1rem;
}
.landing-features .feature-card h3 {
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}
.landing-features .feature-card p {
  font-size: 0.875rem;
  color: var(--text2);
  line-height: 1.6;
}

.landing-footer {
  background: var(--text);
  color: rgba(255, 255, 255, 0.6);
  padding: 2.5rem 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
}
.landing-footer .logo {
  font-weight: 800;
  color: #fff;
  font-size: 1.125rem;
}
.landing-footer .logo span {
  color: var(--accent);
}
.landing-footer .copy {
  font-size: 0.8125rem;
}

:root {
  --accent: #FF6B35;
  --accent-light: #FFF1EB;
  --blue: #3B82F6;
  --blue-light: #EFF6FF;
  --green: #22C55E;
  --green-light: #F0FDF4;
  --amber: #F59E0B;
  --amber-light: #FFFBEB;
  --red: #EF4444;
  --red-light: #FEF2F2;
  --purple: #8B5CF6;
  --purple-light: #F5F3FF;
  --bg: #F8FAFC;
  --surface: #FFFFFF;
  --surface2: #F1F5F9;
  --border: #E2E8F0;
  --text: #0F172A;
  --text2: #475569;
  --text3: #94A3B8;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
  --shadow-md: 0 4px 16px rgba(0,0,0,.12);
  --radius: 12px;
  --sidebar-w: 260px;
  --topbar-h: 64px;
  --transition: all 0.2s ease;
}

.auth-page {
  min-height: 100vh;
  display: flex;
}
.auth-page__left {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  background: var(--surface);
}
.auth-page__left .auth-box {
  width: 100%;
  max-width: 420px;
}
.auth-page__left .auth-logo {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 0.5rem;
  letter-spacing: -0.03em;
}
.auth-page__left .auth-logo span {
  color: var(--accent);
}
.auth-page__left .auth-headline {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 0.375rem;
}
.auth-page__left .auth-sub {
  color: var(--text3);
  font-size: 0.875rem;
  margin-bottom: 2rem;
}
.auth-page__left .auth-error {
  background: var(--red-light);
  color: var(--red);
  border: 1px solid #fecaca;
  border-radius: 8px;
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  margin-bottom: 1rem;
}
.auth-page__left .auth-footer {
  text-align: center;
  margin-top: 1.5rem;
  font-size: 0.875rem;
  color: var(--text2);
}
.auth-page__left .auth-footer a {
  color: var(--accent);
  font-weight: 600;
  cursor: pointer;
}
.auth-page__left .remember-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -0.25rem 0 1.25rem;
  font-size: 0.8125rem;
}
.auth-page__left .remember-row label {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--text2);
  cursor: pointer;
}
.auth-page__left .remember-row a {
  color: var(--accent);
  font-weight: 600;
  cursor: pointer;
}
.auth-page__right {
  flex: 1;
  background: linear-gradient(135deg, var(--text) 0%, #1e293b 50%, #0f172a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 2rem;
  color: white;
}
@media (max-width: 768px) {
  .auth-page__right {
    display: none;
  }
}
.auth-page__right .illus-icon {
  font-size: 6rem;
  margin-bottom: 2rem;
  filter: drop-shadow(0 8px 32px rgba(255, 107, 53, 0.4));
}
.auth-page__right h2 {
  font-size: 1.875rem;
  font-weight: 800;
  margin-bottom: 0.75rem;
  letter-spacing: -0.03em;
}
.auth-page__right p {
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  max-width: 320px;
  line-height: 1.65;
}
.auth-page__right .feat-list {
  margin-top: 2rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  width: 100%;
  max-width: 320px;
}
.auth-page__right .feat-list .feat-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.875rem;
  color: rgba(255, 255, 255, 0.75);
}
.auth-page__right .feat-list .feat-item .check {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.2);
  border: 1px solid rgba(34, 197, 94, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: var(--green);
  flex-shrink: 0;
}

:root {
  --accent: #FF6B35;
  --accent-light: #FFF1EB;
  --blue: #3B82F6;
  --blue-light: #EFF6FF;
  --green: #22C55E;
  --green-light: #F0FDF4;
  --amber: #F59E0B;
  --amber-light: #FFFBEB;
  --red: #EF4444;
  --red-light: #FEF2F2;
  --purple: #8B5CF6;
  --purple-light: #F5F3FF;
  --bg: #F8FAFC;
  --surface: #FFFFFF;
  --surface2: #F1F5F9;
  --border: #E2E8F0;
  --text: #0F172A;
  --text2: #475569;
  --text3: #94A3B8;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
  --shadow-md: 0 4px 16px rgba(0,0,0,.12);
  --radius: 12px;
  --sidebar-w: 260px;
  --topbar-h: 64px;
  --transition: all 0.2s ease;
}

.rider-app {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 1rem;
}
.rider-app .rider-container {
  width: 100%;
  max-width: 420px;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.rider-app .rider-header {
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: 1.5rem;
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rider-app .rider-header .rider-info {
  display: flex;
  align-items: center;
  gap: 12px;
}
.rider-app .rider-header .rider-info .avatar {
  width: 46px;
  height: 46px;
  border-radius: 12px;
  background: var(--accent-light);
  color: var(--accent);
  font-weight: 800;
  font-size: 1.125rem;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rider-app .rider-header .rider-info .name {
  font-weight: 700;
  font-size: 0.9375rem;
}
.rider-app .rider-header .rider-info .orders {
  font-size: 12px;
  color: var(--text3);
  margin-top: 2px;
}
.rider-app .rider-header .online-toggle {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.rider-app .rider-header .online-toggle .toggle-label {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text3);
}
.rider-app .active-delivery {
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: 1.5rem;
  border: 1px solid var(--border);
  border-top: 3px solid var(--accent);
}
.rider-app .active-delivery__label {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent);
  margin-bottom: 0.875rem;
}
.rider-app .active-delivery__order-id {
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--text2);
  margin-bottom: 0.5rem;
}
.rider-app .active-delivery__customer {
  font-size: 1.0625rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}
.rider-app .active-delivery__address {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  color: var(--text2);
  font-size: 0.875rem;
  margin-bottom: 1rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--border);
}
.rider-app .active-delivery__items {
  font-size: 0.8125rem;
  color: var(--text2);
  margin-bottom: 0.75rem;
}
.rider-app .active-delivery__cod {
  background: var(--amber-light);
  color: #92400e;
  border-radius: 8px;
  padding: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}
.rider-app .active-delivery__cod .lbl {
  font-size: 0.8125rem;
  font-weight: 600;
}
.rider-app .active-delivery__cod .val {
  font-size: 1.125rem;
  font-weight: 800;
}
.rider-app .active-delivery__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}
.rider-app .active-delivery__actions .btn-full {
  grid-column: 1/-1;
}
.rider-app .order-queue {
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: 1.5rem;
  border: 1px solid var(--border);
}
.rider-app .order-queue__title {
  font-size: 0.9375rem;
  font-weight: 700;
  margin-bottom: 0.875rem;
}
.rider-app .order-queue .queue-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--border);
}
.rider-app .order-queue .queue-item:last-child {
  border-bottom: none;
}
.rider-app .order-queue .queue-item .order-id {
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--accent);
}
.rider-app .order-queue .queue-item .address {
  font-size: 12px;
  color: var(--text3);
}

body {
  font-family: "DM Sans", sans-serif;
  background: var(--bg);
  color: var(--text);
  margin: 0;
  -webkit-font-smoothing: antialiased;
}

.mt-auto {
  margin-top: auto;
}

.mb-1 {
  margin-bottom: 0.5rem;
}

.mb-2 {
  margin-bottom: 1rem;
}

.mb-3 {
  margin-bottom: 1.5rem;
}

.gap-1 {
  gap: 0.5rem;
}

.gap-2 {
  gap: 1rem;
}

.d-flex {
  display: flex;
}

.align-center {
  align-items: center;
}

.justify-between {
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.w-full {
  width: 100%;
}

.spinner {
  width: 36px;
  height: 36px;
  border: 3px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  margin: 0 auto;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.loading-page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  flex-direction: column;
  gap: 1rem;
  color: var(--text2);
  font-size: 0.875rem;
}
