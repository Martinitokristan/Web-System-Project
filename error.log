@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap");
:root {
  --accent: #FF6B35;
  --accent-light: #FFF1EB;
  --blue: #3B82F6;
  --blue-light: #EFF6FF;
  --green: #22C55E;
  --green-light: #F0FDF4;
  --amber: #F59E0B;
  --amber-light: #FFFBEB;
  --red: #EF4444;
  --red-light: #FEF2F2;
  --purple: #8B5CF6;
  --purple-light: #F5F3FF;
  --bg: #F8FAFC;
