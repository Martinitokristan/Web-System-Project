:root {
  --accent: #FF6B35;
  --accent-light: #FFF1EB;
  --blue: #3B82F6;
  --blue-light: #EFF6FF;
  --green: #22C55E;
  --green-light: #F0FDF4;
  --amber: #F59E0B;
  --amber-light: #FFFBEB;
  --red: #EF4444;
  --red-light: #FEF2F2;
  --purple: #8B5CF6;
  --purple-light: #F5F3FF;
  --bg: #F8FAFC;
  --surface: #FFFFFF;
  --surface2: #F1F5F9;
  --border: #E2E8F0;
  --text: #0F172A;
  --text2: #475569;
  --text3: #94A3B8;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
  --shadow-md: 0 4px 16px rgba(0,0,0,.12);
  --radius: 12px;
  --sidebar-w: 260px;
  --topbar-h: 64px;
  --transition: all 0.2s ease;
}

.admin-layout {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 260px;
  background: var(--text);
  min-height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  z-index: 100;
  transition: var(--transition);
}
.sidebar__logo {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sidebar__logo span {
  color: #fff;
  font-size: 1.125rem;
  font-weight: 700;
  letter-spacing: -0.02em;
}
.sidebar__logo .logo-badge {
  background: var(--accent);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 999px;
}
.sidebar__nav {
  flex: 1;
  padding: 1rem 0;
  overflow-y: auto;
}
.sidebar__section-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.3);
  padding: 0.5rem 1.5rem;
  margin-top: 0.5rem;
}
.sidebar__item, .sidebar__accordion-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0.7rem 1.5rem;
  color: rgba(255, 255, 255, 0.65);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
  border-left: 3px solid transparent;
}
.sidebar__item svg, .sidebar__accordion-btn svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}
.sidebar__item:hover, .sidebar__accordion-btn:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.06);
}
.sidebar__item.active, .active.sidebar__accordion-btn {
  color: #fff;
  background: rgba(255, 107, 53, 0.15);
  border-left-color: var(--accent);
}
.sidebar__accordion-btn {
  justify-content: space-between;
  width: 100%;
  border: none;
  background: none;
}
.sidebar__accordion-btn .arrow {
  transition: transform 0.2s ease;
}
.sidebar__accordion-btn .arrow.open {
  transform: rotate(180deg);
}
.sidebar__sub-items {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.25s ease-out;
}
.sidebar__sub-items.open {
  max-height: 200px;
}
.sidebar__sub-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0.55rem 1.5rem 0.55rem 3.2rem;
  color: rgba(255, 255, 255, 0.55);
  font-size: 0.8125rem;
  cursor: pointer;
  transition: var(--transition);
}
.sidebar__sub-item:hover {
  color: #fff;
}
.sidebar__sub-item.active {
  color: var(--accent);
}
.sidebar__footer {
  padding: 1rem 1.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.topbar {
  position: fixed;
  top: 0;
  left: 260px;
  right: 0;
  height: 64px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 1.5rem;
  z-index: 90;
}
.topbar__title {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--text);
}
.topbar__actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
.topbar__btn {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--text2);
  transition: var(--transition);
  position: relative;
}
.topbar__btn:hover {
  background: var(--surface2);
  color: var(--text);
}
.topbar__btn .badge-dot {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 8px;
  height: 8px;
  background: var(--red);
  border-radius: 50%;
  border: 2px solid var(--surface);
}
.topbar__avatar {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: var(--accent-light);
  color: var(--accent);
  font-weight: 700;
  font-size: 0.875rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: var(--transition);
}
.topbar__avatar:hover {
  background: var(--accent);
  color: #fff;
}

.main-content {
  margin-left: 260px;
  margin-top: 64px;
  flex: 1;
  padding: 1.75rem;
  min-height: calc(100vh - 64px);
  background: var(--bg);
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.pill-tabs {
  display: flex;
  gap: 4px;
  background: var(--surface2);
  padding: 4px;
  border-radius: 10px;
  border: 1px solid var(--border);
  width: fit-content;
}
.pill-tabs .pill-tab {
  padding: 0.4rem 1rem;
  border-radius: 7px;
  font-size: 0.8125rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  border: none;
  background: none;
  color: var(--text2);
}
.pill-tabs .pill-tab.active {
  background: var(--surface);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}
.pill-tabs .pill-tab:hover:not(.active) {
  color: var(--text);
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}

.grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
}

@media (max-width: 1100px) {
  .grid-4 {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 768px) {
  .grid-2, .grid-3, .grid-4 {
    grid-template-columns: 1fr;
  }
  .sidebar {
    transform: translateX(-100%);
  }
  .topbar {
    left: 0;
  }
  .main-content {
    margin-left: 0;
  }
}
.search-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.search-overlay .search-box {
  background: var(--surface);
  border-radius: var(--radius);
  width: 560px;
  max-width: 90vw;
  overflow: hidden;
  box-shadow: var(--shadow-md);
}
.search-overlay .search-box input {
  width: 100%;
  padding: 0.55rem 0.875rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 0.875rem;
  color: var(--text);
  background: var(--surface);
  transition: var(--transition);
  outline: none;
  font-family: inherit;
}
.search-overlay .search-box input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.15);
}
.search-overlay .search-box input::placeholder {
  color: var(--text3);
}
.search-overlay .search-box input {
  border: none;
  border-radius: 0;
  font-size: 1.125rem;
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--border);
}
.search-overlay .search-box .search-hint {
  padding: 1rem 1.5rem;
  color: var(--text3);
  font-size: 0.8125rem;
}

.profile-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  width: 220px;
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-md);
  border: 1px solid var(--border);
  overflow: hidden;
  z-index: 300;
}
.profile-dropdown__user {
  padding: 1rem;
  border-bottom: 1px solid var(--border);
}
.profile-dropdown__user .name {
  font-weight: 600;
  font-size: 0.875rem;
}
.profile-dropdown__user .email {
  font-size: 0.75rem;
  color: var(--text3);
}
.profile-dropdown__item {
  display: flex;
  align-items: center;
  justify-content: center;
  justify-content: flex-start;
  gap: 8px;
  padding: 0.65rem 1rem;
  font-size: 0.875rem;
  color: var(--text2);
  cursor: pointer;
  transition: var(--transition);
}
.profile-dropdown__item:hover {
  background: var(--surface2);
  color: var(--text);
}
.profile-dropdown__item.danger {
  color: var(--red);
}
.profile-dropdown__item.danger:hover {
  background: var(--red-light);
}

:root {
  --accent: #FF6B35;
  --accent-light: #FFF1EB;
  --blue: #3B82F6;
  --blue-light: #EFF6FF;
  --green: #22C55E;
  --green-light: #F0FDF4;
  --amber: #F59E0B;
  --amber-light: #FFFBEB;
  --red: #EF4444;
  --red-light: #FEF2F2;
  --purple: #8B5CF6;
  --purple-light: #F5F3FF;
  --bg: #F8FAFC;
  --surface: #FFFFFF;
  --surface2: #F1F5F9;
  --border: #E2E8F0;
  --text: #0F172A;
  --text2: #475569;
  --text3: #94A3B8;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
  --shadow-md: 0 4px 16px rgba(0,0,0,.12);
  --radius: 12px;
  --sidebar-w: 260px;
  --topbar-h: 64px;
  --transition: all 0.2s ease;
}

.stat-card {
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: 1.5rem;
  border: 1px solid var(--border);
  position: relative;
  overflow: hidden;
  border-top: 3px solid transparent;
  transition: var(--transition);
}
.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}
.stat-card--green {
  border-top-color: var(--green);
}
.stat-card--blue {
  border-top-color: var(--blue);
}
.stat-card--amber {
  border-top-color: var(--amber);
}
.stat-card--accent {
  border-top-color: var(--accent);
}
.stat-card--red {
  border-top-color: var(--red);
}
.stat-card--purple {
  border-top-color: var(--purple);
}
.stat-card__label {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text2);
  margin-bottom: 0.5rem;
}
.stat-card__value {
  font-size: 1.875rem;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
}
.stat-card__trend {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  font-weight: 600;
  margin-top: 0.5rem;
}
.stat-card__trend.up {
  color: var(--green);
}
.stat-card__trend.down {
  color: var(--red);
}
.stat-card__icon {
  position: absolute;
  top: 1rem;
  right: 1rem;
  width: 42px;
  height: 42px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  opacity: 0.85;
}

.filter-bar {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 1.25rem;
  padding: 1rem 1.25rem;
  background: var(--surface);
  border-radius: var(--radius);
  border: 1px solid var(--border);
}
.filter-bar .search-wrap {
  position: relative;
  flex: 1;
  min-width: 200px;
}
.filter-bar .search-wrap input {
  width: 100%;
  padding: 0.55rem 0.875rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 0.875rem;
  color: var(--text);
  background: var(--surface);
  transition: var(--transition);
  outline: none;
  font-family: inherit;
}
.filter-bar .search-wrap input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.15);
}
.filter-bar .search-wrap input::placeholder {
  color: var(--text3);
}
.filter-bar .search-wrap input {
  padding-left: 2.25rem;
}
.filter-bar .search-wrap .search-icon {
  position: absolute;
  left: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text3);
  pointer-events: none;
}
.filter-bar select {
  width: 100%;
  padding: 0.55rem 0.875rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 0.875rem;
  color: var(--text);
  background: var(--surface);
  transition: var(--transition);
  outline: none;
  font-family: inherit;
}
.filter-bar select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.15);
}
.filter-bar select::placeholder {
  color: var(--text3);
}
.filter-bar select {
  width: auto;
  min-width: 150px;
  cursor: pointer;
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 1.25rem;
  flex-wrap: wrap;
  gap: 0.75rem;
}
.pagination__info {
  font-size: 0.8125rem;
  color: var(--text2);
}
.pagination__buttons {
  display: flex;
  gap: 4px;
}
.pagination__btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 7px;
  border: 1px solid var(--border);
  background: var(--surface);
  font-size: 0.8125rem;
  color: var(--text2);
  cursor: pointer;
  transition: var(--transition);
}
.pagination__btn:hover {
  background: var(--surface2);
}
.pagination__btn.active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
.pagination__btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.toast-container {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.toast {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0.875rem 1.25rem;
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: var(--shadow-md);
  border: 1px solid var(--border);
  min-width: 280px;
  max-width: 380px;
  font-size: 0.875rem;
  animation: slideInRight 0.3s ease;
}
.toast.success {
  border-left: 4px solid var(--green);
}
.toast.success .toast__icon {
  color: var(--green);
}
.toast.error {
  border-left: 4px solid var(--red);
}
.toast.error .toast__icon {
  color: var(--red);
}
.toast.info {
  border-left: 4px solid var(--blue);
}
.toast.info .toast__icon {
  color: var(--blue);
}
.toast__msg {
  flex: 1;
  color: var(--text);
  font-weight: 500;
}
.toast__close {
  color: var(--text3);
  cursor: pointer;
}
.toast__close:hover {
  color: var(--text);
}

@keyframes slideInRight {
  from {
    transform: translateX(100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}
.btn {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 0.5rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.btn:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}
.btn:active {
  transform: translateY(0);
}
.btn--ghost {
  background: transparent;
  color: var(--text2);
  border: none;
  border-radius: 8px;
  padding: 0.5rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.btn--ghost:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}
.btn--ghost:active {
  transform: translateY(0);
}
.btn--ghost {
  border: 1px solid var(--border);
}
