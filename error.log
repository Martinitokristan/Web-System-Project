}

input, select, textarea {
  font-family: inherit;
}

h1, h2, h3, h4, h5, h6 {
  font-weight: 600;
  line-height: 1.3;
}

body {
  font-family: "DM Sans", sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: var(--text);
}

